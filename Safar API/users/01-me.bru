meta {
  name: Me
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/me
}

headers {
  authorization: Bearer {{accessToken}}
  accept: application/json
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("response is json", function () {
    const contentType = res.getHeader("content-type") || "";
    expect(contentType.toLowerCase()).to.contain("application/json");
  });

  test("user id exists", function () {
    const body = res.getBody();
    expect(body.id).to.exist;
  });

  test("phone number exists", function () {
    const body = res.getBody();
    expect(body.phone_number).to.exist;
  });

  test("role exists", function () {
    const body = res.getBody();
    expect(body.role).to.exist;
  });
}

docs {
  Returns the current authenticated user using Bearer token from `accessToken`.
}