meta {
  name: List My Driver Trips
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/driver/trips
}

headers {
  authorization: Bearer {{accessToken}}
  accept: application/json
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("response is json", function () {
    const contentType = res.getHeader("content-type") || "";
    expect(contentType.toLowerCase()).to.contain("application/json");
  });

  test("response is array", function () {
    const body = res.getBody();
    expect(Array.isArray(body)).to.equal(true);
  });

  test("items contain trip fields", function () {
    const body = res.getBody();
    if (Array.isArray(body) && body.length > 0) {
      expect(body[0].id).to.exist;
      expect(body[0].driver_id).to.exist;
      expect(body[0].vehicle_id).to.exist;
      expect(body[0].origin).to.exist;
      expect(body[0].destination).to.exist;
      expect(body[0].trip_date).to.exist;
      expect(body[0].available_seats).to.exist;
      expect(body[0].total_seats).to.exist;
      expect(body[0].status).to.exist;
    }
  });
}

docs {
  Returns trip offers for the authenticated driver only.
}
