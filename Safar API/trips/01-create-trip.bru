meta {
  name: Create Driver Trip
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/driver/trips
  body: json
}

headers {
  authorization: Bearer {{accessToken}}
  content-type: application/json
  accept: application/json
}

body:json {
  {
    "vehicle_id": {{vehicleId}},
    "origin": "{{tripOrigin}}",
    "destination": "{{tripDestination}}",
    "trip_date": "{{tripDate}}",
    "available_seats": {{tripAvailableSeats}}
  }
}

tests {
  test("status is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("response is json", function () {
    const contentType = res.getHeader("content-type") || "";
    expect(contentType.toLowerCase()).to.contain("application/json");
  });

  test("trip fields exist", function () {
    const body = res.getBody();
    expect(body.id).to.exist;
    expect(body.driver_id).to.exist;
    expect(body.vehicle_id).to.exist;
    expect(body.origin).to.exist;
    expect(body.destination).to.exist;
    expect(body.trip_date).to.exist;
    expect(body.available_seats).to.exist;
    expect(body.total_seats).to.exist;
    expect(body.status).to.equal("active");
  });

  test("save trip id to environment", function () {
    const body = res.getBody();
    if (body && body.id) {
      bru.setEnvVar("tripId", String(body.id));
      bru.setEnvVar("bookingTripOfferId", String(body.id));
    } else {
      throw new Error("trip id not found in response");
    }
  });
}

docs {
  Creates a trip offer for the authenticated driver.
  Requires `accessToken` and a valid `vehicleId` that belongs to the current user.
}
