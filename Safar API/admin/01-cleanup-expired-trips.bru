meta {
  name: Cleanup Expired Trips
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/admin/cleanup/expired-trips
}

headers {
  authorization: Bearer {{accessToken}}
  accept: application/json
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("response is json", function () {
    const contentType = res.getHeader("content-type") || "";
    expect(contentType.toLowerCase()).to.contain("application/json");
  });

  test("cleanup payload fields exist", function () {
    const body = res.getBody();
    expect(body.message).to.equal("cleanup completed");
    expect(body.expired_trips_count).to.exist;
  });
}

docs {
  Manually triggers cleanup that marks trips older than 7 days as `expired`.
  Endpoint is protected by JWT and intended for debug/admin operations.
}
