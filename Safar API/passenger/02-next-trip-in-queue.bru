meta {
  name: Next Trip In Queue
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/passenger/search/{{searchSessionId}}/next
}

headers {
  authorization: Bearer {{accessToken}}
  accept: application/json
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("response is json", function () {
    const contentType = res.getHeader("content-type") || "";
    expect(contentType.toLowerCase()).to.contain("application/json");
  });

  test("next response fields exist", function () {
    const body = res.getBody();
    expect(body.search_session_id).to.exist;
    expect(body.trip).to.exist;
    expect(body.is_first_in_queue).to.equal(false);
    expect(body.warning).to.exist;
  });
}

docs {
  Returns the next trip in queue for the existing search session.
  Requires `searchSessionId` saved from `Search Trip Queue`.
}
