meta {
  name: Verify OTP
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}{{apiPrefix}}/verify-otp
  body: json
  auth: none
}

headers {
  content-type: application/json
  accept: application/json
}

body {
  {
    "phone_number": "{{phoneNumber}}",
    "code": "{{otpCode}}"
  }
}

tests {
  test("status is 200 or 201", function () {
    expect([200, 201]).to.include(res.getStatus());
  });

  test("response is json", function () {
    const contentType = res.getHeader("content-type") || "";
    expect(contentType.toLowerCase()).to.contain("application/json");
  });

  test("response does not contain auth error", function () {
    const body = res.getBody();
    if (body && typeof body === "object" && body.error) {
      throw new Error(`API returned error: ${body.error}`);
    }
  });
}

docs {
  Verifies the OTP code from the `otpCode` environment variable.

  Update `otpCode` in `environments/local.bru` or inside Bruno before running this request.
}
