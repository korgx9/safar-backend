meta {
  name: Cancel Booking
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/bookings/{{bookingId}}/cancel
}

headers {
  authorization: Bearer {{accessToken}}
  accept: application/json
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("response is json", function () {
    const contentType = res.getHeader("content-type") || "";
    expect(contentType.toLowerCase()).to.contain("application/json");
  });

  test("booking is cancelled", function () {
    const body = res.getBody();
    expect(body.id).to.exist;
    expect(body.status).to.equal("cancelled");
  });
}

docs {
  Cancels booking by `bookingId` for current authenticated passenger.
}
