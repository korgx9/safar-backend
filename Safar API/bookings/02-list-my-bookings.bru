meta {
  name: List My Bookings
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/bookings/my
}

headers {
  authorization: Bearer {{accessToken}}
  accept: application/json
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("response is json", function () {
    const contentType = res.getHeader("content-type") || "";
    expect(contentType.toLowerCase()).to.contain("application/json");
  });

  test("response is array", function () {
    const body = res.getBody();
    expect(Array.isArray(body)).to.equal(true);
  });

  test("items contain booking fields", function () {
    const body = res.getBody();
    if (Array.isArray(body) && body.length > 0) {
      expect(body[0].id).to.exist;
      expect(body[0].trip_offer_id).to.exist;
      expect(body[0].passenger_id).to.exist;
      expect(body[0].requested_seats).to.exist;
      expect(body[0].status).to.exist;
    }
  });
}

docs {
  Returns bookings of the authenticated passenger only.
}
