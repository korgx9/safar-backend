meta {
  name: List Vehicles
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/vehicles
}

headers {
  authorization: Bearer {{accessToken}}
  accept: application/json
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("response is json", function () {
    const contentType = res.getHeader("content-type") || "";
    expect(contentType.toLowerCase()).to.contain("application/json");
  });

  test("response is array", function () {
    const body = res.getBody();
    expect(Array.isArray(body)).to.equal(true);
  });

  test("items contain vehicle fields", function () {
    const body = res.getBody();
    if (Array.isArray(body) && body.length > 0) {
      expect(body[0].id).to.exist;
      expect(body[0].user_id).to.exist;
      expect(body[0].seats_total).to.exist;
    }
  });
}

docs {
  Returns vehicles for the authenticated user only.
  Requires Bearer token in `accessToken`.
}
